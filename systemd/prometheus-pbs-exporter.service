[Unit]
Description=Prometheus Proxmox Backup Server Exporter
Documentation=https://github.com/natrontech/pbs-exporter

[Service]
Restart=always
User=pbs-exporter
# the config file holds the API tokens: chown pbs-exporter and chmod 600 it
ExecStart=/opt/pbs-exporter/pbs-exporter-linux-amd64 -config.file /etc/pbs-exporter/config.yml

[Install]
WantedBy=multi-user.target
